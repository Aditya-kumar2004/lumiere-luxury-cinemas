PORT=5000

# PostgreSQL Connection Details (Replace with your own credentials)
PG_USER=postgres
PG_HOST=localhost
PG_DATABASE=cinema_db
PG_PASSWORD=your_postgres_password
PG_PORT=5432

# JWT Secret Key (Use a strong 256-bit random key)
JWT_SECRET=your_jwt_secret_key_here

# Email Configuration (for sending OTP emails)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
