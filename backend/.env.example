PORT=5000

# Cloud PostgreSQL Connection String (Recommended for Deployment - Neon / Supabase / Render)
# If DATABASE_URL is set, it will be used automatically with SSL enabled.
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Local PostgreSQL Connection Details (Fallback when running locally without cloud DB)
PG_USER=postgres
PG_HOST=localhost
PG_DATABASE=cinema_db
PG_PASSWORD=your_postgres_password
PG_PORT=5432

# JWT Secret Key (Use a strong random key)
JWT_SECRET=your_jwt_secret_key_here

# Email Configuration (for sending OTP emails)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
